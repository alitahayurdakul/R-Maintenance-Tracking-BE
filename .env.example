# Copy to server/.env and adjust. Nothing here is shared with the app's own
# .env - the frontend only ever sees this server through its API_URL.
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/tms-maintenance
ACCESS_TOKEN_SECRET=change-me-access
REFRESH_TOKEN_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Origin allowed to send credentialed requests (the Next.js dev server).
CLIENT_ORIGIN=http://localhost:3000
